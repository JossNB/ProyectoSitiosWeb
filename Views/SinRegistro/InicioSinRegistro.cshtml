@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tixly Eventos</title>
    <link rel="stylesheet" href="~/css/sinRegistro.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- CSS de Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header>
        <div class="top-nav">
            <img src="img/logo.jpg" alt="Tixly Logo" class="logo">
            <div class="search-session">
                <input type="text" placeholder="Buscar...">
                <button>Buscar</button>
                <button>Iniciar Sesión</button>
                <button>Registrarse</button>
            </div>
        </div>
        <nav>
            <a href="#">Conciertos</a>
            <a href="#">Deportes</a>
            <a href="#">Teatro</a>
            <a href="#">Comedia</a>
            <a href="#">Culturales</a>
            <a href="#">Familiares</a>
            <a href="#">Congresos</a>
            <a href="#">Festivales</a>
            <a href="#">Puntos de venta</a>
            <a href="#">Ayuda</a>
        </nav>

        <div class="banner">
            <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="3" aria-label="Slide 4"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="img/reikESTELAR.jpg" class="d-block w-100" alt="Evento 1">
                        <div class="carousel-caption d-none d-md-block">
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="img/melendiESTELAR.jpg" class="d-block w-100" alt="Evento 2">
                        <div class="carousel-caption d-none d-md-block">
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="img/shawnESTELAR.jpg" class="d-block w-100" alt="Evento 3">
                        <div class="carousel-caption d-none d-md-block">
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="img/chayanne.jpg" class="d-block w-100" alt="Evento ">
                        <div class="carousel-caption d-none d-md-block">
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
        <div class="filter-bar">
            <select class="event-filter">
                <option value="all">Todos los Eventos</option>
                <option value="concerts">Conciertos</option>
                <option value="sports">Deportes</option>
                <option value="theatre">Teatro</option>
                <option value="comedy">Comedia</option>
            </select>
            <select class="location-filter">
                <option value="all">Todo Costa Rica</option>
                <option value="sanJose">San José</option>
                <option value="alajuela">Alajuela</option>
                <option value="heredia">Heredia</option>
            </select>
        </div>
    </header>

    <div class="content-wrapper d-flex">
        <main class="main-content">
            <div class="card-container">
                <!-- Main content cards go here -->
                <!-- Example of a card, repeat as needed -->
                <div class="card">
                    <img src="img/reik.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Reik en concierto</h3>
                        <button>Ver Más</button>
                    </div>
                </div>
                <div class="card">
                    <img src="img/bluey.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Bluey en vivo</h3>
                        <button>Ver Más</button>
                    </div>
                </div>
                <div class="card">
                    <img src="img/chayanne.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Chayanne</h3>
                        <button>Ver Más</button>
                    </div>
                </div>
                <div class="card">
                    <img src="img/comiccon.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Comic Con</h3>
                        <button>Ver Más</button>
                    </div>
                </div>
                <div class="card">
                    <img src="img/cortocircuito.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Corto Circuito</h3>

                        <button>Ver Más</button>
                    </div>
                </div>
                <div class="card">
                    <img src="img/michaeljackson.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Michael Jackson and friends</h3>

                        <button>Ver Más</button>
                    </div>
                </div>
                <div class="card">
                    <img src="img/shawn.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Shawn Mendes</h3>

                        <button>Ver Más</button>
                    </div>

                </div>
                <div class="card">
                    <img src="img/triatlon.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Triatlon</h3>

                        <button>Ver Más</button>
                    </div>

                </div>
                <div class="card">
                    <img src="img/veranoextremo.jpg" alt="Reik" class="card-img">
                    <div class="card-content">
                        <h3>Verano Extremo</h3>

                        <button>Ver Más</button>
                    </div>
                </div>
            </div>
        </main>
        <aside class="sidebar">
            <div class="card">
                <img src="img/melendi.jpg" alt="Melendi" class="card-img">
                <div class="card-content">
                    <button>Ver Más</button>
                </div>
            </div>
            <div class="card">
                <img src="img/quevedo.jpg" alt="Melendi" class="card-img">
                <div class="card-content">
                    <button>Ver Más</button>
                </div>
            </div>
            <div class="card">
                <img src="img/playaherradura.jpg" alt="Melendi" class="card-img">
                <div class="card-content">
                    <button>Ver Más</button>
                </div>
            </div>
        </aside>
    </div>

    <footer>
        <div class="footer-container">
            <div class="footer-section">
                <h5>¡Somos Tixly!</h5>
                <!-- No visible content here except a title -->
            </div>
            <div class="footer-section">
                <h5>Contacto</h5>
                <p>Cartago, Costa Rica</p>
                <p>servicio_alcliente@tixly.com</p>
                <p>+506 70-40-65-89</p>
            </div>
            <div class="footer-section">
                <h5>Síganos</h5>
                <a href="https://facebook.com" target="_blank" class="bi bi-facebook"></a>
                <a href="https://instagram.com" target="_blank" class="bi bi-instagram"></a>
            </div>
        </div>
    </footer>

    <!-- JavaScript y Bundle de Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
