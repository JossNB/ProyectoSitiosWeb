@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Tixtly</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        body {
            background-image: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), url('@Url.Action("ObtenerFondoMenu", "PanelCliente")');
            background-size: 100%;
            color: #fff;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #adff44;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
        }

        .search-bar {
            display: flex;
            align-items: center;
        }

            .search-bar input {
                padding: 5px;
                border: none;
                border-radius: 5px;
                margin-right: 5px;
            }

            .search-bar button {
                background-color: #000;
                color: #A8FF2D;
                border: none;
                padding: 5px 10px;
                cursor: pointer;
            }

        .user-menu {
            position: relative;
            display: inline-block;
        }

        .user-button {
            background-color: black;
            color: white;
            border: none;
            padding: 8px 50px;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            border-radius: 5px;
        }

            .user-button i {
                font-size: 14px;
            }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: white;
            min-width: 250px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.2);
            border-radius: 5px;
            z-index: 1;
            top: 100%;
            right: 0;
        }

            .dropdown-content a {
                color: black;
                padding: 10px;
                text-decoration: none;
                display: block;
                font-size: 14px;
            }

                .dropdown-content a:hover {
                    background-color: #adff44;
                }

        /* Mostrar menú cuando la clase 'show' está activa */
        .show {
            display: block;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #adff44; /* Fondo verde para la barra principal */
            padding: 10px 20px;
            color: black;
        }

            nav ul {
                list-style: none;
                display: flex;
                gap: 15px;
                margin: 0;
                padding: 0;
            }

                nav ul li {
                    cursor: pointer;
                }

        .nav-right {
            background-color: black; /* Fondo negro para la sección derecha */
            padding: 10px 20px;
            display: flex;
            gap: 15px;
        }

            .nav-right a {
                color: white; /* Letras blancas para mejor contraste */
                text-decoration: none;
                margin-left: 15px;
            }


        main {
            padding: 20px;
            text-align: center;
        }

        .dashboard {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background-color: #0e0e0e;
            padding: 20px;
            width: 180px;
            text-align: center;
            border-radius: 10px;
            border: 1px solid #343433;
        }

            .card i {
                font-size: 2rem;
                color: #adff44;
            }

            .card p{
                font-size: 14px;
                margin-bottom: 25px;
            }

            .card h3{
                font-size: 16px;
                margin-bottom: 30px;
            }
          
            .card .arrow {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                background-color: #0e0e0e;
                color: #ffffff;
                border-radius: 50%;
                font-size: 24px;
                margin-top: 10px;
                border: 2px solid #ffffff;
            }

        .header .logo-sitio {
            max-width: 100%;
            height: auto;
            max-height: 10px;
            object-fit: contain;
        }

        .titulo-compras{
            margin-right: 800px;
            margin-top: 40px;
        }

        .titulo-bienvenida{
            margin-right: 650px;
        }

        footer {
            background: #222;
            padding: 20px;
            margin-top: 20px;
            display: flex;
            justify-content: space-around;
        }

        .btn-buscar {
            border-radius: 5px;
            height: 26px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <header>
        <div>
            <img src="@Url.Action("ObtenerLogoSitio", "Cliente")" alt="Logo del sitio" class="logo-sitio" style="max-height: 85px; width: auto;" />
        </div>

        <div class="search-bar">
            <i class="fas fa-search" style="margin-right:10px; color:black"></i>
            <input type="text" style="margin-right: 100px; width:300px" placeholder="Buscar...">
            <button class="btn-buscar" style="margin-left:-90px; color:#adff44"> BUSCAR</button>
        </div>

        <div class="user-menu">
            <button class="user-button" onclick="toggleDropdown()">
                <i class="fas fa-user" style="color:#adff44; margin-right:20px"></i>NOMBRE<i class="fas fa-chevron-down" style="color:#adff44; margin-left:20px"></i>
            </button>
            <div id="userDropdown" class="dropdown-content">
                <a href="#">Mi Cuenta</a>
                <a href="#">Cerrar Sesión</a>
            </div>
        </div>
    </header>
    <nav>
        <ul>
            <li>Conciertos</li>
            <li>Deportes</li>
            <li>Teatro</li>
            <li>Comedia</li>
            <li>Culturales</li>
            <li>Familiares</li>
            <li>Congresos</li>
            <li>Festivales</li>
        </ul>
        <div class="nav-right">
            <a href="#">Puntos de venta</a>
            <a href="#">Ayuda</a>
        </div>
    </nav>
    <main>
        <h2 class="titulo-bienvenida">Bienvenido: <span>NOMBRE</span></h2>
        <div class="dashboard">
            <div class="card">
                <h3>Información personal</h3>
                <i class="fas fa-user"></i>               
                <p>Mantenimiento de información personal.</p>
                <div class="arrow"><i style="color:#ffffff" class="fas fa-arrow-right"></i></div>
            </div>
            <div class="card">
                <h3>Cambio de contraseña</h3>
                <i class="fas fa-lock"></i>
                <p>Modifique su contraseña actual.</p>
                <div class="arrow"><i style="color:#ffffff" class="fas fa-arrow-right"></i></div>
            </div>
            <div class="card">
                <h3>Actividad reciente</h3>
                <i class="fas fa-book"></i>             
                <p>Consulte su actividad reciente.</p>
                <div class="arrow"><i style="color:#ffffff" class="fas fa-arrow-right"></i></div>
            </div>
            <div class="card">
                <h3>Notificaciones</h3>
                <i class="fas fa-bell"></i>               
                <p>Reciba actualizaciones de sus eventos.</p>
                <div class="arrow"><i style="color:#ffffff" class="fas fa-arrow-right"></i></div>
            </div>
        </div>
        <h2 class="titulo-compras">Compras</h2>
        <div class="dashboard">
            <div class="card">
                <h3>Historial de compras</h3>
                <i class="fas fa-shopping-cart"></i>                
                <p>Informe de sus compras realizadas.</p>
                <div class="arrow"><i style="color:#ffffff" class="fas fa-arrow-right"></i></div>
            </div>
            <div class="card">
                <h3>Mis tiquetes</h3>
                <i class="fas fa-ticket-alt"></i>             
                <p>Información de sus tiquetes disponibles.</p>
                <div class="arrow"><i style="color:#ffffff" class="fas fa-arrow-right"></i></div>
            </div>
            <div class="card">
                <h3>Cancelaciones</h3>
                <i class="fas fa-times-circle"></i>             
                <p>Gestione la cancelación de sus tiquetes.</p>
                <div class="arrow"><i style="color:#ffffff" class="fas fa-arrow-right"></i></div>
            </div>

            <div class="card" style="visibility: hidden;"></div>
        </div>
    </main>
    <footer>
        <div class="info">
            <p>¡Somos <span class="highlight">Tixtly!</span></p>
            <p>Transferencias Seguras</p>
            <p>Entradas 100% digitales</p>
        </div>
        <div class="contact">
            <p>Cartago, Costa Rica</p>
            <p>servicio_alcliente@tixtly.com</p>
            <p>+506 70-40-65-89</p>
        </div>
        <div class="social">
            <p>Síguenos</p>
        </div>
    </footer>
</body>
</html>
